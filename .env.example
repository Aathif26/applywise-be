# ── Application ────────────────────────────────────────────────────────────
APP_NAME=ApplyWise AI
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://applywise_user:change_this_local_password@localhost:5432/applywise_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO_SQL=false

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list (parsed as JSON array by pydantic-settings)
CORS_ORIGINS=["http://localhost:3000"]

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

